        #rawTextSection.mt-4.d-none
          h5.text-primary.mb-2
            i.fas.fa-bug.me-2
            | Raw AI Output (DEBUG)
          pre#rawTextArea.bg-dark.text-success.p-3.rounded(style="max-height: 300px; overflow-y: auto; white-space: pre-wrap; font-size: 0.85rem;")

block scripts
  script(src="https://cdn.jsdelivr.net/npm/d3@7")
  script(src="https://cdn.jsdelivr.net/npm/markmap-lib@0.15.4")
  script(src="https://cdn.jsdelivr.net/npm/markmap-view@0.15.4")

  script.
    // Biến toàn cục để theo dõi trạng thái
    let isSaving = false;
    let mindmapData = null;
    let mindmapRawJson = null;
    let visualizationUrl = null;
    let streamAbortController = null;
    let streamRawJson = '';
    let isProcessing = false;
    let currentFile = null;
    let startTime = null;

    function renderDemoMindmap() {
      try {
        if (typeof window.markmap === 'undefined' || typeof window.markmap.Transformer === 'undefined') {
          setTimeout(renderDemoMindmap, 100);
          return;
        }

        const { Transformer, Markmap } = window.markmap;

        const sampleMarkdown = `# Demo Mindmap\n## 1. Tải lên\n  - PDF\n  - DOCX\n  - TXT\n## 2. Phân tích\n  - Trích xuất nội dung\n  - AI tóm tắt\n  - Tạo các nhánh\n## 3. Kết quả\n  - Sơ đồ tương tác\n  - Nội dung Markdown`;
        const transformer = new Transformer();
        const { root, features } = transformer.transform(sampleMarkdown.trim());

        const svg = document.getElementById('demoMindmap');
        if (svg) {
          Markmap.create(svg, {}, root);
        }
      } catch (e) {
        console.error("Lỗi render demo mindmap:", e);
        const svg = document.getElementById('demoMindmap');
        if(svg) svg.innerHTML = '<p class="text-center text-danger p-4">Không thể tải sơ đồ mẫu.</p>';
      }
    }
    document.addEventListener('DOMContentLoaded', renderDemoMindmap);

    // DOM Elements
    const uploadForm = document.getElementById('uploadForm');
    const documentInput = document.getElementById('documentFile');
    const fileInfo = document.getElementById('fileInfo');
    const submitBtn = document.getElementById('submitBtn');
    const progressArea = document.getElementById('progressArea');
    const progressStatus = document.getElementById('progressStatus');
    const progressText = document.getElementById('progressText');
    const progressBar = document.getElementById('progressBar');
    const resultArea = document.getElementById('resultArea');
    const errorArea = document.getElementById('errorArea');
    const errorMessage = document.getElementById('errorMessage');
    const createMindmapBtn = document.getElementById('createMindmapBtn');
    const viewVisualizationBtn = document.getElementById('viewVisualizationBtn');
    const viewJsonBtn = document.getElementById('viewJsonBtn');
    const newUploadBtn = document.getElementById('newUploadBtn');
    const jsonPreview = document.getElementById('jsonPreview');
    const mindmapPreview = document.getElementById('mindmapPreview');
    const copyJsonBtn = document.getElementById('copyJsonBtn');
    const downloadJsonBtn = document.getElementById('downloadJsonBtn');
    const fileUploadArea = document.querySelector('.file-upload-area');
    const rawTextSection = document.getElementById('rawTextSection');
    const rawTextArea = document.getElementById('rawTextArea');
    const completionTimeSpan = document.getElementById('completionTime');
    const streamPreviewArea = document.getElementById('streamPreviewArea');
    const streamPreview = document.getElementById('streamPreview');
    const streamCharCount = document.getElementById('streamCharCount');
    const liveMindmapArea = document.getElementById('liveMindmapArea');
    const liveMindmap = document.getElementById('liveMindmap');

    // File Upload Handlers
    fileUploadArea.addEventListener('click', () => documentInput.click());
    fileUploadArea.addEventListener('dragover', (e) => { 
      e.preventDefault(); 
      fileUploadArea.classList.add('border-primary', 'bg-light'); 
    });
    fileUploadArea.addEventListener('dragleave', () => { 
      fileUploadArea.classList.remove('border-primary', 'bg-light'); 
    });
    fileUploadArea.addEventListener('drop', (e) => { 
      e.preventDefault(); 
      fileUploadArea.classList.remove('border-primary', 'bg-light'); 
      if (e.dataTransfer.files.length > 0) handleFileSelection(e.dataTransfer.files[0]); 
    });
    documentInput.addEventListener('change', (e) => { 
      if (e.target.files.length > 0) handleFileSelection(e.target.files[0]); 
    });

    function handleFileSelection(file) {
      const allowedTypes = ['application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'text/plain', 'image/jpeg', 'image/png', 'image/gif'];
      if (!allowedTypes.includes(file.type)) {
        showError(`Loại file không hợp lệ: ${file.type}. Chỉ chấp nhận PDF, DOCX, TXT, JPG, PNG, GIF.`);
        resetFileSelection();
        return;
      }

      currentFile = file;
      const fileSize = (file.size / (1024 * 1024)).toFixed(2);
      if (fileSize > 50) { 
        showError('File quá lớn! Vui lòng chọn file nhỏ hơn 50MB.'); 
        resetFileSelection(); 
        return;
      }
      
      fileInfo.innerHTML = `<div class="alert alert-success py-2 d-flex justify-content-between align-items-center">
        <span class="me-2"><i class="fas fa-file me-2"></i><strong>${file.name}</strong> (${fileSize} MB)</span>
        <button type="button" class="btn-close btn-sm" onclick="resetFileSelection(event)"></button>
      </div>`;
      
      fileUploadArea.classList.add('border-success');
      submitBtn.disabled = false;
      hideError();
    }

    function resetFileSelection(event) {
      if(event) event.stopPropagation();
      documentInput.value = '';
      fileInfo.innerHTML = '';
      fileUploadArea.classList.remove('border-success', 'border-primary', 'bg-light');
      currentFile = null;
      submitBtn.disabled = true;
      hideError();
    }

    // Upload Form Handler
    uploadForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (isProcessing || !currentFile) {
        showError(isProcessing ? 'Đang xử lý file trước đó. Vui lòng đợi...' : 'Vui lòng chọn một file.');
        return;
      }

      isProcessing = true;
      startTime = Date.now();
      submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang tải lên...';
      submitBtn.disabled = true;
      progressArea.style.display = 'block';
      const skeletonArea = document.getElementById('skeletonArea');
      if (skeletonArea) skeletonArea.style.display = 'block';
      updateProgressBar(0, '0%');
      progressStatus.textContent = 'Đang khởi tạo kết nối...';
      resultArea.style.display = 'none';
      jsonPreview.style.display = 'none';
      hideError();
      mindmapData = null;
      visualizationUrl = null;
      streamRawJson = '';
      if (streamPreviewArea) streamPreviewArea.style.display = 'none';
      if (streamPreview) streamPreview.textContent = '';
      if (streamCharCount) streamCharCount.textContent = '0 ký tự';
      if (liveMindmapArea) liveMindmapArea.style.display = 'none';
      if (liveMindmap) liveMindmap.innerHTML = '';
      if (streamAbortController) streamAbortController.abort();

      rawTextSection.classList.add('d-none');
      rawTextArea.textContent = '';
      resetResultButtons();

      const formData = new FormData();
      formData.append('documentFile', currentFile);

      try {
        streamAbortController = new AbortController();
        const streamResponse = await fetch('/upload/summarize-stream', { 
          method: 'POST', 
          body: formData,
          signal: streamAbortController.signal
        });

        if (!streamResponse.ok) {
          let errorData;
          try { errorData = await streamResponse.json(); }
          catch (e) { errorData = { error: `Lỗi ${streamResponse.status}: ${streamResponse.statusText}` }; }
          throw new Error(errorData.error || `Lỗi server ${streamResponse.status}`);
        }

        if (!streamResponse.body) throw new Error('Trình duyệt không hỗ trợ đọc stream phản hồi.');

        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...';
        progressStatus.textContent = 'Đã kết nối stream, đang xử lý tài liệu...';
        await readSSEStream(streamResponse.body);

      } catch (error) {
        console.error("Error in uploadForm submit:", error);
        if (error.name !== 'AbortError') showError('Lỗi Khởi tạo: ' + error.message);
        resetProcessingState();
      }
    });

    async function readSSEStream(body) {
      const reader = body.getReader();
      const decoder = new TextDecoder('utf-8');
      let buffer = '';

      while (true) {
        const { value, done } = await reader.read();
        if (done) break;

        buffer += decoder.decode(value, { stream: true });
        const eventBlocks = buffer.split(/\n\n/);
        buffer = eventBlocks.pop() || '';
        eventBlocks.forEach(handleSSEBlock);
      }

      if (buffer.trim()) handleSSEBlock(buffer);
    }

    function handleSSEBlock(block) {
      let eventName = 'message';
      const dataLines = [];

      block.split(/\r?\n/).forEach((line) => {
        if (line.startsWith('event:')) eventName = line.slice(6).trim();
        else if (line.startsWith('data:')) dataLines.push(line.slice(5).trim());
      });

      if (!dataLines.length) return;

      let data;
      try {
        data = JSON.parse(dataLines.join('\n'));
      } catch (e) {
        console.error('Không parse được SSE data:', e, dataLines.join('\n'));
        return;
      }

      handleStreamEvent(eventName, data);
    }

    function handleStreamEvent(eventName, data) {
      if (eventName === 'progress') {
        if (data.message) progressStatus.textContent = data.message;
        if (typeof data.percent === 'number') updateProgressBar(data.percent, `${Math.round(data.percent)}%`);
        return;
      }

      if (eventName === 'object_delta') {
        streamRawJson += data.delta || '';
        streamPreviewArea.style.display = 'block';
        streamPreview.textContent = streamRawJson.slice(-6000);
        streamPreview.scrollTop = streamPreview.scrollHeight;
        streamCharCount.textContent = `${data.receivedChars || streamRawJson.length} ký tự`;

        // Dynamic JSON repair & rendering for real-time generative UI
        if (streamRawJson.trim().length > 10) {
          const repaired = repairIncompleteJson(streamRawJson);
          if (repaired && typeof repaired === 'object') {
            const skeletonArea = document.getElementById('skeletonArea');
            if (skeletonArea) skeletonArea.style.display = 'none';
            liveMindmapArea.style.display = 'block';
            renderLiveMindmapFromObject(repaired);
          }
        }

        if (parseInt(progressBar.getAttribute('aria-valuenow') || '0', 10) < 80) {
          updateProgressBar(60, '60%');
        }
        return;
      }

      if (eventName === 'object_partial') {
        streamRawJson = JSON.stringify(data.partial || {}, null, 2);
        streamPreviewArea.style.display = 'block';
        streamPreview.textContent = streamRawJson.slice(-6000);
        streamPreview.scrollTop = streamPreview.scrollHeight;
        streamCharCount.textContent = `${data.receivedChars || streamRawJson.length} ký tự`;

        const skeletonArea = document.getElementById('skeletonArea');
        if (skeletonArea) skeletonArea.style.display = 'none';
        liveMindmapArea.style.display = 'block';

        renderLiveMindmapFromObject(data.partial);
        if (parseInt(progressBar.getAttribute('aria-valuenow') || '0', 10) < 80) {
          updateProgressBar(65, '65%');
        }
        return;
      }

      if (eventName === 'complete') {
        handleCompleteEvent(data);
        return;
      }

      if (eventName === 'error') {
        showError(`Lỗi từ Server: ${data.message || 'Lỗi không xác định'}`);
        resetProcessingState();
      }
    }

    function handleCompleteEvent(data) {
      mindmapData = data.markdown;
      mindmapRawJson = data.mindmap;
      visualizationUrl = data.visualizationUrl;
      renderLiveMarkdown(mindmapData);

      progressStatus.textContent = 'Hoàn thành!';
      updateProgressBar(100, '100%');
      const duration = ((Date.now() - startTime) / 1000).toFixed(1);
      completionTimeSpan.innerHTML = `<i class="fas fa-clock me-1"></i> Thời gian: ${duration}s`;

      setTimeout(() => {
        progressArea.style.display = 'none';
        resultArea.style.display = 'block';
        mindmapPreview.textContent = mindmapData || "Không có nội dung Markdown được tạo.";
        isProcessing = false;
        streamAbortController = null;
        resetSubmitButton();
        resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });

        createMindmapBtn.disabled = !mindmapData;
        if (visualizationUrl) {
          viewVisualizationBtn.style.display = 'inline-flex';
          viewVisualizationBtn.onclick = () => { window.open(visualizationUrl, '_blank'); };
        } else {
          viewVisualizationBtn.style.display = 'none';
        }
      }, 500);
    }

    function renderLiveMindmapFromObject(partial) {
      if (!partial || typeof partial !== 'object') return;
      const markdown = objectToMarkdown(partial);
      if (!markdown || markdown.trim().length < 3) return;
      renderLiveMarkdown(markdown);
    }

    function repairIncompleteJson(jsonStr) {
      let cleaned = jsonStr.trim();
      if (!cleaned) return null;

      function tryRepair(str) {
        let stack = [];
        let inString = false;
        let escaped = false;
        let repaired = "";

        for (let i = 0; i < str.length; i++) {
          const char = str[i];
          repaired += char;

          if (escaped) {
            escaped = false;
            continue;
          }
          if (char === '\\' && inString) {
            escaped = true;
            continue;
          }
          if (char === '"') {
            inString = !inString;
            continue;
          }
          if (inString) continue;

          if (char === '{' || char === '[') {
            stack.push(char);
          } else if (char === '}') {
            if (stack[stack.length - 1] === '{') stack.pop();
          } else if (char === ']') {
            if (stack[stack.length - 1] === '[') stack.pop();
          }
        }

        if (inString) repaired += '"';
        
        let temp = repaired.trim();
        if (temp.endsWith(',')) {
          temp = temp.slice(0, -1).trim();
        }

        let tempStack = [...stack];
        while (tempStack.length > 0) {
          const open = tempStack.pop();
          if (open === '{') temp += '}';
          else if (open === '[') temp += ']';
        }

        try {
          return JSON.parse(temp);
        } catch (e) {
          return null;
        }
      }

      let parsed = tryRepair(cleaned);
      if (parsed) return parsed;

      for (let len = cleaned.length - 1; len > 0 && cleaned.length - len < 150; len--) {
        const char = cleaned[len];
        if (char === ',' || char === ':' || char === '[' || char === '{' || char === '"') {
          const prefix = cleaned.slice(0, len);
          parsed = tryRepair(prefix);
          if (parsed) return parsed;
        }
      }

      return null;
    }

    // Convert structured object to Markdown format
    function objectToMarkdown(source) {
      const lines = [];
      const clean = (value) => String(value || '').replace(/\s+/g, ' ').trim();
      const rootTitle = clean(source.mainTopic) || 'Sơ đồ tư duy';
      lines.push(`# ${rootTitle}`);

      if (source.summary) {
        lines.push(`- ${clean(source.summary)}`);
      }

      const appendChild = (node, depth) => {
        const title = clean(node?.title || node?.chapterTitle);
        if (!title) return;
        if (depth <= 6) {
          lines.push(`${'#'.repeat(depth)} ${title}`);
          (node.points || []).forEach((point) => {
            const text = clean(point);
            if (text) lines.push(`- ${text}`);
          });
          (node.children || []).forEach((child) => appendChild(child, depth + 1));
        } else {
          const indent = '  '.repeat(depth - 6);
          lines.push(`${indent}- ${title}`);
          (node.points || []).forEach((point) => {
            const text = clean(point);
            if (text) lines.push(`${indent}  - ${text}`);
          });
          (node.children || []).forEach((child) => appendChild(child, depth + 1));
        }
      };

      (source.subTopics || []).forEach((topic) => appendChild(topic, 2));
      return lines.join('\n');
    }

    function renderLiveMarkdown(markdown) {
      if (!liveMindmap || !markdown) return;
      try {
        if (typeof window.markmap === 'undefined' || typeof window.markmap.Transformer === 'undefined') return;
        const { Transformer, Markmap } = window.markmap;
        const transformer = new Transformer();
        const { root } = transformer.transform(markdown.trim());
        liveMindmapArea.style.display = 'block';
        liveMindmap.innerHTML = '';
        Markmap.create(liveMindmap, { autoFit: true, duration: 200 }, root);
      } catch (error) {
        console.error('Không thể render live mindmap:', error);
      }
    }

    // Result Buttons Handlers
    viewJsonBtn.addEventListener('click', () => {
      jsonPreview.style.display = jsonPreview.style.display === 'none' ? 'block' : 'none';
      if (jsonPreview.style.display === 'block') {
        jsonPreview.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });

    newUploadBtn.addEventListener('click', () => {
      console.log("New upload requested.");
      resetFileSelection();
      resultArea.style.display = 'none';
      jsonPreview.style.display = 'none';
      progressArea.style.display = 'none';
      hideError();
      mindmapData = null;
      visualizationUrl = null;
      startTime = null;
      streamRawJson = '';
      if (streamPreviewArea) streamPreviewArea.style.display = 'none';
      if (streamPreview) streamPreview.textContent = '';
      if (streamCharCount) streamCharCount.textContent = '0 ký tự';
      if (liveMindmapArea) liveMindmapArea.style.display = 'none';
      if (liveMindmap) liveMindmap.innerHTML = '';
      if (streamAbortController) {
        streamAbortController.abort();
        streamAbortController = null;
      }
      isProcessing = false;
      resetSubmitButton();
      resetResultButtons();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    copyJsonBtn.addEventListener('click', async () => {
      if (mindmapData) {
        try {
          await navigator.clipboard.writeText(mindmapData);
          copyJsonBtn.innerHTML = '<i class="fas fa-check me-1"></i>Đã sao chép!';
          copyJsonBtn.classList.remove('btn-outline-success');
          copyJsonBtn.classList.add('btn-success');
          setTimeout(() => {
            copyJsonBtn.innerHTML = '<i class="fas fa-copy me-1"></i>Sao chép';
            copyJsonBtn.classList.remove('btn-success');
            copyJsonBtn.classList.add('btn-outline-success');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy text: ', err);
          alert('Không thể sao chép vào clipboard.');
        }
      }
    });

    downloadJsonBtn.addEventListener('click', () => {
      if (mindmapData) {
        try {
          const blob = new Blob([mindmapData], { type: 'text/markdown;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.style.display = 'none';
          a.href = url;
          const safeFilename = (currentFile?.name || 'mindmap').replace(/\.[^/.]+$/, "").replace(/[^a-z0-9]/gi, '_').toLowerCase();
          a.download = `${safeFilename}-${Date.now()}.md`;
          document.body.appendChild(a);
          a.click();
          window.URL.revokeObjectURL(url);
          document.body.removeChild(a);
        } catch (e) {
          console.error("Error creating download link:", e);
          alert("Không thể tạo file để tải xuống.");
        }
      }
    });

    // Save Mindmap Function
    async function saveMindmap() {
      if (isSaving) {
        console.log("⏳ Đang lưu, vui lòng đợi...");
        return;
      }
      
      if (!mindmapData) {
        alert('Không có dữ liệu mindmap để lưu.');
        return;
      }

      if (isProcessing) {
        alert('Đang có tiến trình khác chạy, vui lòng đợi.');
        return;
      }

      console.log("💾 Bắt đầu lưu mindmap...");
      isSaving = true;
      
      createMindmapBtn.disabled = true;
      createMindmapBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang lưu...';

      let title = 'Mindmap không có tiêu đề';
      try {
        const firstLine = mindmapData.split('\n')[0];
        if (firstLine && firstLine.startsWith('#')) {
          title = firstLine.replace(/^#+\s*/, '').trim() || title;
        }
      } catch (e) { 
        console.warn("Không thể trích xuất tiêu đề từ markdown.");
      }

      try {
        console.log("📤 Gửi request lưu mindmap...");
        const response = await fetch('/mindmaps/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: title, content: mindmapData, mindmapJson: mindmapRawJson }),
        });

        const result = await response.json();
        console.log("📥 Response từ server:", result);

        if (!response.ok) {
          throw new Error(result.error || `Lỗi server ${response.status} khi lưu`);
        }

        if (result.redirectUrl) {
          console.log("🔄 Redirect đến:", result.redirectUrl);
          window.location.href = result.redirectUrl;
        } else {
          alert(result.message || 'Lưu thành công!');
          isSaving = false;
          createMindmapBtn.disabled = false;
          createMindmapBtn.innerHTML = '<i class="fas fa-save me-2"></i>Lưu và Tạo Mindmap';
        }

      } catch (error) {
        console.error("❌ Lỗi khi lưu mindmap:", error);
        alert('Lỗi khi lưu Mindmap:\n' + error.message);
        
        isSaving = false;
        createMindmapBtn.disabled = false;
        createMindmapBtn.innerHTML = '<i class="fas fa-save me-2"></i>Lưu và Tạo Mindmap';
      }
    }

    createMindmapBtn.addEventListener('click', function(e) {
      e.preventDefault();
      saveMindmap();
    });

    // Utility Functions
    function resetResultButtons() {
      createMindmapBtn.disabled = true;
      createMindmapBtn.innerHTML = '<i class="fas fa-save me-2"></i>Lưu và Tạo Mindmap';
      viewVisualizationBtn.style.display = 'none';
      viewVisualizationBtn.onclick = null;
    }

    function showError(message) {
      errorMessage.textContent = message;
      errorArea.style.display = 'block';
      errorArea.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function hideError() {
      errorArea.style.display = 'none';
      errorMessage.textContent = '';
    }

    function resetSubmitButton() {
      submitBtn.innerHTML = '<i class="fas fa-robot me-2"></i>Bắt đầu phân tích tài liệu';
      submitBtn.disabled = !currentFile;
    }

    function resetProcessingState() {
      console.log("Resetting processing state.");
      isProcessing = false;
      startTime = null;
      resetSubmitButton();
      progressArea.style.display = 'none';
      updateProgressBar(0, '0%');
      streamRawJson = '';
      if (streamPreviewArea) streamPreviewArea.style.display = 'none';
      if (streamPreview) streamPreview.textContent = '';
      if (streamCharCount) streamCharCount.textContent = '0 ký tự';
      if (liveMindmapArea) liveMindmapArea.style.display = 'none';
      if (liveMindmap) liveMindmap.innerHTML = '';
      if (streamAbortController) {
        streamAbortController.abort();
        streamAbortController = null;
      }
      resetResultButtons();
    }

    function updateProgressBar(value, text) {
      value = Math.max(0, Math.min(100, value));
      progressBar.style.width = `${value}%`;
      progressBar.setAttribute('aria-valuenow', value);
      progressText.textContent = text;
    }

    // Cleanup on page unload
    window.addEventListener('beforeunload', (event) => {
      if (streamAbortController) {
        streamAbortController.abort();
        streamAbortController = null;
      }
    });

    // Initialize
    submitBtn.disabled = true;