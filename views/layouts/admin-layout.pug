extends default.pug

block styles
  style.
    .admin-container {
      display: flex;
      min-height: calc(100vh - 150px);
    }
    .admin-sidebar {
      width: 260px;
      background-color: #2c3e50;
      color: #ecf0f1;
      padding: 20px 0;
      transition: all 0.3s;
    }
    .admin-sidebar .sidebar-heading {
      padding: 10px 20px;
      font-size: 1.2rem;
      font-weight: bold;
      border-bottom: 1px solid #34495e;
      margin-bottom: 20px;
      letter-spacing: 1px;
    }
    .admin-sidebar .nav-link {
      color: #bdc3c7;
      padding: 12px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      transition: all 0.2s;
      border-left: 4px solid transparent;
      text-decoration: none;
    }
    .admin-sidebar .nav-link:hover {
      color: #fff;
      background-color: #34495e;
      border-left-color: #3498db;
    }
    .admin-sidebar .nav-link.active {
      color: #fff;
      background-color: #34495e;
      border-left-color: #2ecc71;
      font-weight: 600;
    }
    .admin-content {
      flex: 1;
      padding: 30px;
      background-color: #f5f6fa;
    }
    .admin-card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      background: #fff;
      margin-bottom: 30px;
    }
    .admin-card-header {
      background: none;
      border-bottom: 1px solid #f1f2f6;
      padding: 20px;
      font-weight: 600;
      font-size: 1.1rem;
    }
    .stats-card {
      border: none;
      border-radius: 12px;
      transition: transform 0.2s;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }
    .stats-card:hover {
      transform: translateY(-5px);
    }
    .table-responsive {
      border-radius: 10px;
      overflow: hidden;
    }
    .badge-active {
      background-color: #d4edda;
      color: #155724;
    }
    .badge-locked {
      background-color: #f8d7da;
      color: #721c24;
    }

block main
  .admin-container
    .admin-sidebar
      .sidebar-heading
        i.fas.fa-shield-halved.me-2
        | Admin MindTree
      nav.nav.flex-column
        a.nav-link(href="/admin/dashboard" class=(pageTitle === 'Admin Dashboard' ? 'active' : ''))
          i.fas.fa-chart-pie
          | Tổng quan
        a.nav-link(href="/admin/users" class=(pageTitle === 'Quản lý người dùng' ? 'active' : ''))
          i.fas.fa-users
          | Người dùng
        a.nav-link(href="/admin/documents" class=(pageTitle === 'Kiểm duyệt tài liệu' ? 'active' : ''))
          i.fas.fa-file-shield
          | Tài liệu hệ thống
        a.nav-link.text-info.mt-5(href="/dashboard")
          i.fas.fa-arrow-left-long
          | Về Sinh viên
    .admin-content
      block admin_content
