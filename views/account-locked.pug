doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Tài Khoản Bị Khóa | MindTree
    link(rel="stylesheet", href="/css/style-login.css")
    style.
      .locked-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 20px 10px;
      }
      .lock-icon-wrapper {
        width: 80px;
        height: 80px;
        background: rgba(255, 75, 75, 0.15);
        border: 2px dashed rgba(255, 75, 75, 0.4);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 24px;
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 75, 75, 0.4); }
        70% { transform: scale(1.05); box-shadow: 0 0 0 15px rgba(255, 75, 75, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 75, 75, 0); }
      }
      .lock-title {
        font-size: 28px;
        font-weight: 800;
        color: #ff5252;
        margin-bottom: 16px;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
      }
      .lock-description {
        font-size: 16px;
        line-height: 24px;
        color: rgba(255,255,255,0.85);
        margin-bottom: 28px;
      }
      .appeal-box {
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 28px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .appeal-label {
        font-size: 13px;
        color: rgba(255,255,255,0.5);
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .appeal-email-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(0, 0, 0, 0.25);
        border-radius: 6px;
        padding: 8px 12px;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
      .appeal-email {
        font-family: 'Courier New', Courier, monospace;
        font-size: 16px;
        font-weight: bold;
        color: #2ea1ff;
        text-decoration: none;
        word-break: break-all;
      }
      .btn-copy {
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: #fff;
        padding: 6px 12px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-copy:hover {
        background: #2ea1ff;
        color: #fff;
      }
      .btn-logout-locked {
        width: 100%;
        padding: 12px;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
        box-sizing: border-box;
      }
      .btn-logout-locked:hover {
        background: rgba(255, 75, 75, 0.15);
        border-color: #ff4b4b;
      }

  body.login-page
    //- Video background
    .video-bg
      video#bg-video(autoplay muted loop playsinline)
        source(src="/videos/typing.mp4", type="video/mp4")
      .video-overlay

    //- centered wrapper
    .login-wrapper
      .login-card(style="max-width: 500px; display: block; padding: 40px;")
        .locked-container
          .lock-icon-wrapper
            svg(width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ff4b4b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
              rect(x="3" y="11" width="18" height="11" rx="2" ry="2")
              path(d="M7 11V7a5 5 0 0 1 10 0v4")
          
          h2.lock-title Tài khoản đã bị khóa
          p.lock-description Tài khoản của bạn đã bị khóa do vi phạm chính sách của hệ thống.
          
          .appeal-box
            span.appeal-label Liên hệ để kháng cáo qua Gmail
            .appeal-email-container
              a.appeal-email(href="mailto:vietdungtsn@gmail.com") vietdungtsn@gmail.com
              button.btn-copy(onclick="copyEmail()") Sao chép
          
          a.btn-logout-locked(href="/logout") Đăng xuất tài khoản khác

    script.
      (function(){
        var v = document.getElementById('bg-video');
        if (v && v.paused) {
          v.play().catch(function(){});
        }
      })();
      
      function copyEmail() {
        navigator.clipboard.writeText('vietdungtsn@gmail.com').then(function() {
          var btn = document.querySelector('.btn-copy');
          btn.textContent = 'Đã sao chép!';
          btn.style.background = '#28a745';
          setTimeout(function() {
            btn.textContent = 'Sao chép';
            btn.style.background = 'rgba(255, 255, 255, 0.1)';
          }, 2000);
        }).catch(function(err) {
          console.error('Không thể sao chép: ', err);
        });
      }
